@startuml

left to right direction

actor "Student Team" as Student
actor "Panel Judge" as Judge
actor "Public Voter" as Voter

rectangle "Student Project Portfolio & Showcase App" {

    usecase "Create Project Profile" as UC1
    usecase "Submit Project" as UC2
    usecase "Validate GitHub Repository" as UC3
    usecase "Upload Multimedia Artifacts" as UC4
    usecase "View Projects" as UC5
    usecase "Grade Project" as UC6
    usecase "Apply Digital Rubric" as UC7
    usecase "Vote for Project" as UC8
    usecase "Apply Anti-Sybil Protection" as UC9
    usecase "View Leaderboard" as UC10
}

Student --> UC1
Student --> UC2
Student --> UC4

Judge --> UC5
Judge --> UC6

Voter --> UC5
Voter --> UC8
Voter --> UC10

UC2 ..> UC3 : <<include>>
UC6 ..> UC7 : <<include>>
UC8 ..> UC9 : <<include>>

UC4 ..> UC2 : <<extend>>

@enduml